{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f6fb" },
      "foreground": { "$value": "#20243a" },
      "border": { "$value": "#e3e5f0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#20243a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#20243a" },
      "primary": {
        "$value": "#303779",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fafafa" },
      "secondary": { "$value": "#6a6cb4" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#eff0f7" },
      "mutedForeground": { "$value": "#656a82" },
      "accent": { "$value": "#73cba4" },
      "accentForeground": { "$value": "#173c32" },
      "destructive": { "$value": "#b8424f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e1e4ef" },
      "ring": { "$value": "#7777c8" },
      "chart1": { "$value": "#303779" },
      "chart2": { "$value": "#7777c8" },
      "chart3": { "$value": "#58a987" },
      "chart4": { "$value": "#966018" },
      "chart5": { "$value": "#c15d69" },
      "sidebar": { "$value": "#fafafa" },
      "sidebarForeground": { "$value": "#393e59" },
      "sidebarBorder": { "$value": "#e3e5f0" },
      "sidebarPrimary": { "$value": "#303779" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#ededf8" },
      "sidebarAccentForeground": { "$value": "#303779" },
      "sidebarRing": { "$value": "#7777c8" }
    },
    "dark": {
      "background": { "$value": "#17192d" },
      "foreground": { "$value": "#f2f3fa" },
      "border": { "$value": "#383b59" },
      "card": { "$value": "#20233b" },
      "cardForeground": { "$value": "#f2f3fa" },
      "popover": { "$value": "#242743" },
      "popoverForeground": { "$value": "#f2f3fa" },
      "primary": { "$value": "#5962b6" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#8b8ddd" },
      "secondaryForeground": { "$value": "#202344" },
      "muted": { "$value": "#2a2d47" },
      "mutedForeground": { "$value": "#b3b6ce" },
      "accent": { "$value": "#73cba4" },
      "accentForeground": { "$value": "#173c32" },
      "destructive": { "$value": "#a13d4a" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#414564" },
      "ring": { "$value": "#a0a2ed" },
      "chart1": { "$value": "#a0a2ed" },
      "chart2": { "$value": "#73cba4" },
      "chart3": { "$value": "#e5b96b" },
      "chart4": { "$value": "#c08bd7" },
      "chart5": { "$value": "#e18391" },
      "sidebar": { "$value": "#1a1c32" },
      "sidebarForeground": { "$value": "#e8eaf7" },
      "sidebarBorder": { "$value": "#343752" },
      "sidebarPrimary": { "$value": "#5962b6" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#2a2d49" },
      "sidebarAccentForeground": { "$value": "#c2c5f0" },
      "sidebarRing": { "$value": "#a0a2ed" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Clear, compact UI and body typeface, loaded from Google Fonts."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft, rounded corners; component radius steps derive from this base."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
