{
  "name": "attendwise",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/attendwise/vite.config.ts",
    "start": "tsx server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/test-analytics.ts && tsx scripts/test-persistence.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase": "^13.0.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.2",
    "typescript": "~5.9.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "esbuild": "0.25.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0"
  }
}
